# ═══════════════════════════════════════════════════════════════
#  Ghostty — Ember Blackout
#  true black OLED (#060608) + ember accent (#d2772e) + JetBrainsMono
# ═══════════════════════════════════════════════════════════════

# ─── Шрифт ───
font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-thicken = true
adjust-cell-height = 12%

# ─── Палитра Ember Blackout ───
background = #060608
foreground = #c8c8d0
cursor-color = #d2772e
cursor-text = #060608
selection-background = #d2772e
selection-foreground = #060608

# ANSI (приглушённая тёплая палитра — не кислотная)
palette = 0=#16161a
palette = 1=#d45c5c
palette = 2=#7a9f6c
palette = 3=#d2aa46
palette = 4=#6a8caf
palette = 5=#a87fb0
palette = 6=#6fa6a0
palette = 7=#c8c8d0
palette = 8=#6c6c78
palette = 9=#e06c6c
palette = 10=#8fb37e
palette = 11=#e0bc5a
palette = 12=#7fa0c4
palette = 13=#bb95c2
palette = 14=#82bcb6
palette = 15=#e6e6eb

# ─── Внешний вид (аскет, true black) ───
background-opacity = 1.0
window-padding-x = 8
window-padding-y = 6
window-decoration = true
window-theme = dark
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# ─── Поведение ───
shell-integration = fish
shell-integration-features = cursor,sudo,title
confirm-close-surface = false
copy-on-select = clipboard
scrollback-limit = 100000
clipboard-read = allow
clipboard-write = allow

# ─── Горячие клавиши ───
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
