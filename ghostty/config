# ═══════════════════════════════════════════════════════════════
#  Ghostty — Blackout
#  true black OLED (#060608) + gray accent (#d0d0d8) + JetBrainsMono
# ═══════════════════════════════════════════════════════════════

# ─── Шрифт ───
font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-thicken = true
adjust-cell-height = 12%

# ─── Палитра Blackout ───
background = #060608
foreground = #c8c8d0
cursor-color = #d0d0d8
cursor-text = #060608
selection-background = #d0d0d8
selection-foreground = #060608

# ANSI (приглушённая тёплая палитра — не кислотная)
palette = 0=#16161a
palette = 1=#808080
palette = 2=#8e8e8e
palette = 3=#c8c8d0
palette = 4=#868686
palette = 5=#919191
palette = 6=#959595
palette = 7=#c8c8d0
palette = 8=#6c6c78
palette = 9=#8f8f8f
palette = 10=#a2a2a2
palette = 11=#bcbcbc
palette = 12=#9a9a9a
palette = 13=#a5a5a5
palette = 14=#aaaaaa
palette = 15=#e6e6eb

# ─── Внешний вид (аскет, true black) ───
background-opacity = 1.0
window-padding-x = 8
window-padding-y = 6
window-decoration = true
window-theme = dark
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# ─── Поведение ───
shell-integration = fish
shell-integration-features = cursor,sudo,title
confirm-close-surface = false
copy-on-select = clipboard
scrollback-limit = 100000
clipboard-read = allow
clipboard-write = allow

# ─── Горячие клавиши ───
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
