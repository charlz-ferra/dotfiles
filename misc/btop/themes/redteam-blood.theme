# Redteam/Blood btop theme — графит + кроваво-красный
# Монохром-база, графики уходят серый→кровь

theme[main_bg]=""
theme[main_fg]="#c8c8d0"
theme[title]="#c8c8d0"
theme[hi_fg]="#d2772e"
theme[selected_bg]="#26262c"
theme[selected_fg]="#d2772e"
theme[inactive_fg]="#6c6c78"
theme[graph_text]="#9a9aa6"
theme[meter_bg]="#26262c"
theme[proc_misc]="#d2772e"

theme[cpu_box]="#2a2a30"
theme[mem_box]="#2a2a30"
theme[net_box]="#2a2a30"
theme[proc_box]="#2a2a30"
theme[div_line]="#26262c"

# Температура: зелёный → янтарь → кровь (семантика жара)
theme[temp_start]="#6c8f5f"
theme[temp_mid]="#d2aa46"
theme[temp_end]="#d2772e"

# CPU: серый → тёмная кровь → кровь
theme[cpu_start]="#3a3a42"
theme[cpu_mid]="#a85a20"
theme[cpu_end]="#d2772e"

# Память
theme[free_start]="#3a3a42"
theme[free_mid]=""
theme[free_end]="#6c6c78"
theme[cached_start]="#3a3a42"
theme[cached_mid]=""
theme[cached_end]="#9a9aa6"
theme[available_start]="#3a3a42"
theme[available_mid]=""
theme[available_end]="#c8c8d0"
theme[used_start]="#a85a20"
theme[used_mid]=""
theme[used_end]="#d2772e"

# Сеть
theme[download_start]="#3a3a42"
theme[download_mid]="#a85a20"
theme[download_end]="#d2772e"
theme[upload_start]="#3a3a42"
theme[upload_mid]="#a85a20"
theme[upload_end]="#d2772e"

# Графики процессов
theme[process_start]="#3a3a42"
