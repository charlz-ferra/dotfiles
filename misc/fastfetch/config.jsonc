{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": { "top": 1, "right": 3 },
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "red" },
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─" },
    { "type": "os", "key": " os", "keyColor": "red" },
    { "type": "kernel", "key": " kernel", "keyColor": "red" },
    { "type": "packages", "key": " pkgs", "keyColor": "white" },
    { "type": "shell", "key": " shell", "keyColor": "white" },
    { "type": "de", "key": " de", "keyColor": "red" },
    { "type": "wm", "key": " wm", "keyColor": "red" },
    { "type": "terminal", "key": " term", "keyColor": "red" },
    { "type": "cpu", "key": " cpu", "keyColor": "white" },
    { "type": "gpu", "key": " gpu", "keyColor": "white" },
    { "type": "memory", "key": " mem", "keyColor": "red" },
    { "type": "uptime", "key": " up", "keyColor": "red" },
    "break",
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" },
  ],
}
