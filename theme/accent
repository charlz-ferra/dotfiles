#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
#  accent — (re)apply the MonoBlack look across Plasma + shell.
#  Strict monochrome: black / white / gray, no color options.
#  Run after a Global-Theme apply re-tinted things, or just to
#  reassert the palette.
#  Usage:  accent
# ═══════════════════════════════════════════════════════════════
set -uo pipefail
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"

SCHEME=MonoBlack
RGB="208,208,216"
HEX="d0d0d8"
BRIGHT="e8e8ee"

echo "◼ MonoBlack → reapply"

# accent BEFORE scheme, else KDE tints decorations with the old accent
kwriteconfig6 --file kdeglobals --group General --key AccentColor "$RGB"
kwriteconfig6 --file kdeglobals --group General --key accentColorFromWallpaper false

# toggle via a stock scheme to force tint regen, then set MonoBlack
plasma-apply-colorscheme BreezeDark >/dev/null 2>&1 || true
plasma-apply-colorscheme "$SCHEME" >/dev/null 2>&1 || true

# KDE auto-tints Header (toolbars) with accent → force graphite (strict/minimal)
kwriteconfig6 --file kdeglobals --group "Colors:Header" --key BackgroundNormal "15,15,18"
kwriteconfig6 --file kdeglobals --group "Colors:Header" --key BackgroundAlternate "22,22,26"
kwriteconfig6 --file kdeglobals --group "Colors:Header" --key ForegroundNormal "208,208,216"
kwriteconfig6 --file kdeglobals --group "Colors:Header" --group "Inactive" --key BackgroundNormal "16,16,20"
kwriteconfig6 --file kdeglobals --group General --key accentActiveTitlebar false

# starship palette in tone
ST="$HOME/.config/starship.toml"
if [ -f "$ST" ]; then
  sed -i "s/^accent = \"#.*/accent = \"#$HEX\"/" "$ST"
  sed -i "s/^bright = \"#.*/bright = \"#$BRIGHT\"/" "$ST"
fi

# reload kwin + plasma
qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true

echo "✓ Готово. Новые окна подхватят сразу; запущенные Qt-апп — после рестарта."
